# /etc/systemd/system/erpnext-hardware-bridge.service
# Alternative zu `erpnext-hardware-bridge -service install`, mit eigenem
# Dienstbenutzer und Härtung. Siehe scripts/install-linux.sh.
[Unit]
Description=ERPNext Hardware Bridge
After=network.target

[Service]
User=hwbridge
Group=hwbridge
# dialout: serielle Ports; plugdev: USB-Kamera (Phase 2)
SupplementaryGroups=dialout plugdev
ExecStart=/opt/erpnext-hardware-bridge/erpnext-hardware-bridge -config /etc/erpnext-hardware-bridge/bridge.yaml -log-file -
Restart=always
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Die Oberfläche schreibt bridge.yaml (+ .bak) in das Konfigurationsverzeichnis.
# Der Programmordner ist beschreibbar, damit die Bridge ein (signiertes)
# Update selbst einspielen kann.
ReadWritePaths=/etc/erpnext-hardware-bridge /opt/erpnext-hardware-bridge

[Install]
WantedBy=multi-user.target
